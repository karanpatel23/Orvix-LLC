# ---------------------------------------------------------------------------
# Email delivery for the quote form.
#
# CONTACT_FROM_EMAIL IS REQUIRED BY BOTH PROVIDERS. Setting RESEND_API_KEY on
# its own is not enough — the app will refuse to boot rather than accept quote
# requests it cannot deliver.
#
# Configure EITHER Resend (preferred) OR SMTP. If both are set, Resend wins.
# ---------------------------------------------------------------------------

# --- Option A: Resend ---
RESEND_API_KEY=

# --- Option B: SMTP (all three required together) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Required with either option ---
# Must be an address on a domain you have verified with your provider.
CONTACT_FROM_EMAIL=

# Where quote requests are delivered. Defaults to info@orvixllc.com if unset.
CONTACT_TO_EMAIL=info@orvixllc.com
